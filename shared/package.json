{
  "name": "@suiteworks/suitetools-shared",
  "displayName": "SuiteTools Shared",
  "description": "Shared utilities for SuiteTools",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "private": true,
  "author": {
    "name": "Matthew Plant",
    "url": "https://idev.systems/"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/idev-systems/labs/SuiteTools",
    "directory": "shared"
  },
  "license": "GPL-3.0-or-later",
  "keywords": [
    "netsuite",
    "suitescript",
    "suitecloud",
    "typescript",
    "utilities"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.mjs",
      "require": "./dist/errors/index.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.mjs",
      "require": "./dist/contracts/index.cjs"
    }
  },
  "scripts": {
    "build": "yarn build:types && yarn build:bundle",
    "build:types": "tsc -b --verbose",
    "build:bundle": "rollup -c",
    "typecheck": "yarn build:types",
    "watch": "tsc -b --watch --verbose --diagnostics --listEmittedFiles",
    "lint": "yarn run -T biome check .",
    "clean-local": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "lint:fix": "yarn run -T biome check --write .",
    "format": "yarn run -T biome format --write .",
    "check-format": "yarn run -T biome format ."
  },
  "dependencies": {
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-sucrase": "^5.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.52.3",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
