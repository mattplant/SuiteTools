{
  "name": "suitetools",
  "displayName": "SuiteTools monorepo",
  "description": "The monorepo for SuiteTools",
  "version": "1.0.0-beta.2",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^24.0.0"
  },
  "author": {
    "name": "Matthew Plant",
    "url": "https://idev.systems/"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/idev-systems/labs/SuiteTools"
  },
  "bugs": {
    "url": "https://gitlab.com/idev-systems/labs/SuiteTools/-/issues"
  },
  "homepage": "https://gitlab.com/idev-systems/labs/SuiteTools",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "netsuite",
    "suitescript",
    "suitecloud",
    "suitetools",
    "typescript",
    "monorepo",
    "react",
    "vite",
    "tailwindcss",
    "developer-onboarding"
  ],
  "scripts": {
    "sdf-account-setup": "yarn workspace backend suitecloud account:setup",
    "watch:backend": "yarn workspace backend run watch",
    "build:all": "yarn workspace frontend run build && yarn workspace backend run build",
    "deploy:all": "yarn build:all && yarn workspace backend run deploy",
    "lint": "yarn run -T biome check .",
    "typecheck": "yarn workspace @suiteworks/suitetools-shared run typecheck && yarn workspace frontend run typecheck && yarn workspace backend run typecheck",
    "test": "yarn workspace @suiteworks/suitetools-shared run build && yarn workspaces foreach -Apt --verbose run test",
    "postinstall": "node ./scripts/check-node.mjs && echo '✅ Reminder: In VS Code, open Command Palette → TypeScript: Select TypeScript Version → Use Workspace Version'",
    "clean": "yarn workspaces foreach -Apt run clean-local && yarn cache clean && find . -name '*.tsbuildinfo' -delete",
    "yarn:reset": "./scripts/resetYarn.sh",
    "generate-third-party-licenses": "./scripts/generate-third-party-licenses.sh",
    "lint:fix": "yarn run -T biome check --write .",
    "format": "yarn run -T biome format --write .",
    "check-format": "yarn run -T biome format ."
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "dependencies": {
    "typescript": "6.0.3"
  },
  "dependenciesMeta": {
    "@hitc/netsuite-types@2024.2.12": {
      "unplugged": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@yarnpkg/esbuild-plugin-pnp": "^3.0.0-rc.15",
    "esbuild": "^0.25.11",
    "globals": "^16.3.0",
    "remark": "^15.0.1",
    "title-case": "^4.3.2"
  },
  "resolutions": {
    "zod": "^4.0.14",
    "@babel/core": "^7.28.0"
  },
  "overrides": {
    "@oracle/suitecloud-cli": "3.1.0"
  }
}
