{
  "name": "frontend",
  "displayName": "SuiteTools Frontend",
  "description": "The frontend for the missing NetSuite tools.",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "author": {
    "name": "Matthew Plant",
    "url": "https://idev.systems/"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/idev-systems/labs/SuiteTools",
    "directory": "frontend"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build-and-deploy": "yarn build && yarn deploy && echo \"SuiteTools frontend build and deploy completed at $(date).\"",
    "build": "yarn workspace @suiteworks/suitetools-shared run build && tsc && vite build",
    "deploy": "cd ../backend && suitecloud file:upload --paths /SuiteScripts/SuiteTools/dist/index.html /SuiteScripts/SuiteTools/dist/output.css /SuiteScripts/SuiteTools/dist/app-bundle.js",
    "clean-local": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "yarn run -T biome check .",
    "check-format": "yarn run -T biome format .",
    "format": "yarn run -T biome format --write .",
    "lint:fix": "yarn run -T biome check --write .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@suiteworks/suitetools-shared": "workspace:*",
    "d3": "7.9.0",
    "flowbite-react": "0.12.17",
    "react": "19.2.8",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.60.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@oracle/suitecloud-cli": "3.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3": "^7.4.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
