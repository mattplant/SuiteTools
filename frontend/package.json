{
  "name": "frontend",
  "displayName": "SuiteTools Frontend",
  "description": "The frontend for the missing NetSuite tools.",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "author": {
    "name": "Matthew Plant",
    "url": "https://idev.systems/"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/idev-systems/labs/SuiteTools",
    "directory": "frontend"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build-and-deploy": "yarn build && yarn deploy && echo \"SuiteTools frontend build and deploy completed at $(date).\"",
    "build": "tsc && vite build",
    "prebuild": "yarn workspace @suiteworks/suitetools-shared build",
    "deploy": "cd ../backend && suitecloud file:upload --paths /SuiteScripts/SuiteTools/dist/index.html /SuiteScripts/SuiteTools/dist/output.css /SuiteScripts/SuiteTools/dist/app-bundle.js",
    "postinstall": "node -e \"process.exit(process.env.CI?0:1)\" || yarn dlx @yarnpkg/sdks vscode && echo '✅ Reminder: In VS Code, open Command Palette → TypeScript: Select TypeScript Version → Use Workspace Version'",
    "clean-local": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "check-format": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix && yarn format",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@suiteworks/suitetools-shared": "workspace:*",
    "d3": "7.9.0",
    "flowbite": "^3.1.2",
    "flowbite-react": "0.10.2",
    "react": "18.3.1",
    "react-data-grid": "7.0.0-beta.47",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.60.0",
    "react-router-dom": "6.22.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@oracle/suitecloud-cli": "3.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3": "^7.4.3",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.4.21",
    "eslint": "*",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "postcss-import": "16.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-nesting": "^13.0.2",
    "prettier": "3.3.3",
    "tailwindcss": "3.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.9.2"
}
