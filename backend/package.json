{
  "name": "backend",
  "displayName": "SuiteTools Backend",
  "description": "The backend service for the missing NetSuite tools.",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "author": {
    "name": "Matthew Plant",
    "url": "https://idev.systems/"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/idev-systems/labs/SuiteTools",
    "directory": "backend"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "deploy": "suitecloud project:deploy",
    "validate": "suitecloud project:validate",
    "prebuild": "yarn workspace @suiteworks/suitetools-shared build",
    "build": "yarn build:dev",
    "build:dev": "node build/main.mjs --dev",
    "build:prod": "node build/main.mjs --prod",
    "build:check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "clean-local": "rm -rf src/FileCabinet/SuiteScripts/SuiteTools/",
    "test": "jest",
    "format": "prettier --write ./TypeScripts"
  },
  "dependencies": {
    "@suiteworks/suitetools-shared": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@hitc/netsuite-types": "2024.2.12",
    "@oracle/suitecloud-cli": "^3.1.0",
    "@oracle/suitecloud-unit-testing": "^1.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "esbuild": "*",
    "eslint": "*",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-suitescript": "^1.3.2",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "ts-jest": "^29.4.0",
    "typescript": "5.7.3",
    "zod": "^3.23.8"
  },
  "packageManager": "yarn@4.9.2"
}
