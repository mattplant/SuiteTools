// backend workspace tsconfig.json
// Self-contained config for type checking only (--noEmit)
{
  "compilerOptions": {
    /* Language & Module Settings */
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Type System */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Module Resolution & Interop */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* NetSuite-Specific */
    "experimentalDecorators": true,
    "paths": { "N": ["../node_modules/@hitc/netsuite-types/N"], "N/*": ["../node_modules/@hitc/netsuite-types/N/*"] }
  },

  "include": ["TypeScripts"],
  "exclude": ["node_modules"]
}
