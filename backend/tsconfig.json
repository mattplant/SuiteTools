// backend workspace tsconfig.json
// Self-contained config for type checking only (--noEmit)
{
  "compilerOptions": {
    /* Language & Module Settings */
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Type System - Gradually increasing strictness (#28) */
    "strict": false, // TODO: Enable once strictNullChecks lands, then drop the opt-outs below
    "noImplicitAny": true,
    "strictNullChecks": false, // TODO: 18 errors across 8 files -- the remaining phase of #28
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Module Resolution & Interop */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* NetSuite-Specific */
    "experimentalDecorators": true,
    "paths": { "N": ["../node_modules/@hitc/netsuite-types/N"], "N/*": ["../node_modules/@hitc/netsuite-types/N/*"] }
  },

  "include": ["TypeScripts"],
  "exclude": ["node_modules"]
}
